    "# Model definition\n",
    "def make_mlp(dim):\n",
    "    \"\"\"\n",
    "    MLP: multilayer perceptron is the simplest standard type of neural network where each layer's output feeds the next\n",
    "    \"\"\"\n",
    "    mlp = nn.Sequential(\n",
    "        nn.Linear(dim, 32),\n",
    "        nn.ReLU(), \n",
    "        nn.Dropout(0.2),\n",
    "        nn.Linear(32, 16),\n",
    "        nn.ReLU(),\n",
    "        nn.Linear(16, 1)\n",
    "    )\n",
    "    return mlp\n",
    "\n",
    "# Loss function\n",
    "loss_function = nn.BCEWithLogitsLoss()\n",
    "\n",
    "X_val_t, y_val_t = torch.from_numpy(X_val_pca), torch.from_numpy(y_val.astype(np.float32))\n",
    "\n",
    "@torch.no_grad()  # turns off gradient tracking \n",
    "def predict_logits(model, pca_set):\n",
    "    \"\"\"\n",
    "    Converts numpy array to a tensor, run forward pass, drop extra dimensions, and convert back to numpy for sklearn metrics\n",
    "    \"\"\"\n",
    "    model.eval()\n",
    "    return model(torch.from_numpy(pca_set)).squeeze(1).numpy()\n",
    "\n",
    "def train_mlp(seed, max_epochs=300, patience=20, lr=1e-3, weight_decay=1e-4):\n",
    "    \"\"\"\n",
    "    Train an MLP with Adam and early stopping on validation loss.\n",
    "\n",
    "    Args:\n",
    "        seed (int): for reproducibility\n",
    "        max_epochs (int): max number of passes over the training data\n",
    "        patience (int): max number of epochs without improvement before stopping\n",
    "        lr (float): learning rate\n",
    "        weight_decay (float): penalty that discourages large weights\n",
    "    \n",
    "    Returns:\n",
    "        model: trained MLP model with best-validation weights loaded\n",
    "        history (list[tuple[float, float]]): per-epoch (train_loss, val_loss)\n",
    "    \"\"\"\n",
    "    torch.manual_seed(seed)\n",
    "    model = make_mlp(2)\n",
    "    opt = torch.optim.Adam(model.parameters(), lr=lr, weight_decay=weight_decay)  # create optimizer (algorithm updates weights and it adapts the step sizer per weight)\n",
    "    \n",
    "    best_loss = float('inf')\n",
    "    best_state = None\n",
    "    count = 0\n",
    "    history = []\n",
    "    for epoch in range(max_epochs):\n",
    "        model.train()\n",
    "        running = 0.0\n",
    "        for features, labels in train_dl:\n",
    "            opt.zero_grad()\n",
    "            loss = loss_function(model(features).squeeze(1), labels)  # forward \n",
    "            loss.backward()  # backward\n",
    "            opt.step()\n",
    "\n",
    "            # add up batch loss weighted by batch size \n",
    "            running += loss.item() * len(features)\n",
    "\n",
    "        model.eval()\n",
    "        with torch.no_grad():\n",
    "            val_loss = loss_function(model(X_val_t).squeeze(1), y_val_t).item()\n",
    "        history.append((running/len(X_train_pca), val_loss))  # record avg training loss and val loss for training curves\n",
    "        \n",
    "        if val_loss < best_loss:\n",
    "            best_loss = val_loss  # update best_loss\n",
    "            best_state = copy.deepcopy(model.state_dict())  # save a copy of the weights\n",
    "            count = 0  # reset count\n",
    "        else:\n",
    "            # no improvement => update count\n",
    "            count += 1\n",
    "            if count >= patience:\n",
    "                # early stop\n",
    "                break\n",
    "    \n",
    "    model.load_state_dict(best_state)\n",
    "    return model, history\n"
