    "## 4. PyTorch Pipeline\n",
    "Use `TensorDataset` and `DataLoader` to handle batching and shuffling."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "id": "b94e468e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_loader(X_pca, labels, shuffle):\n",
    "    \"\"\"\n",
    "    Create a loader to feed dataset into the model in batches\n",
    "    Args:\n",
    "        X_pca: PCA train, val, or test sets (X_train_pca, X_val_pca X_test_pca)\n",
    "        labels: y_train, y_val, or y_test \n",
    "        shuffle (bool): reorders samples every epoch so the model does not see the data in the same order each time\n",
    "    \"\"\"\n",
    "    ds = TensorDataset(\n",
    "        torch.from_numpy(X_pca), \n",
    "        torch.from_numpy(labels.astype(np.float32))\n",
    "        )  # pair each row of features with its labels\n",
    "\n",
    "    # feeds dataset to the model in batches of 32\n",
    "    return DataLoader(ds, batch_size=32, shuffle=shuffle)\n",
    "    \n",
    "train_dl = make_loader(X_train_pca, y_train, shuffle=True)"
   ]
  },
  {
