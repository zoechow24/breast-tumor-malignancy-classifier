  },
  {
   "cell_type": "markdown",
   "id": "cc7a68bd",
   "metadata": {},
   "source": [
    "## 3. Data Standardization & Feature Engineering\n",
    "The data will be spilt using a 80:20 train-test ratio. The training group will be spit again 80:20 to create a validation set. The validation set is used only for early stopping, and the test set is used for the final evaluation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "a8a7594f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Variance retained: 62.54%\n"
     ]
    }
   ],
   "source": [
    "# stratified train-test split (80:20)\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y, random_state=24)\n",
    "\n",
    "# split train set to include have train and validataion \n",
    "X_train, X_val, y_train, y_val = train_test_split(X_train, y_train, test_size=0.2, stratify=y_train, random_state=24)\n",
    "\n",
    "# pca fitting v2\n",
    "scaler = StandardScaler().fit(X_train)  # scale to train set\n",
    "X_train_scaled = scaler.transform(X_train)\n",
    "X_val_scaled = scaler.transform(X_val)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "pca = PCA(n_components=2).fit(X_train_scaled)\n",
    "prep = lambda x: pca.transform(x).astype(np.float32)\n",
    "\n",
    "X_train_pca = prep(X_train_scaled)\n",
    "X_val_pca = prep(X_val_scaled)\n",
    "X_test_pca = prep(X_test_scaled)\n",
    "\n",
    "# check variance data\n",
    "explained_var = pca.explained_variance_ratio_\n",
    "total_var = explained_var.sum()*100\n",
    "print(f\"Variance retained: {total_var:.2f}%\")"
   ]
  },
